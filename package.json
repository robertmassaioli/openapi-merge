{
  "name": "openapi-merge",
  "version": "1.0.0",
  "description": "The parent openapi-merge package",
  "main": "index.js",
  "repository": "git@github.com-personal:robertmassaioli/openapi-merge.git",
  "author": "Robert Massaioli <robertmassaioli@gmail.com>",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "bun run --filter '*' lint",
    "test": "bun run --filter '*' test",
    "coverage": "bun run test && bun scripts/coverage-summary.ts",
    "build": "bun run --filter '*' build",
    "cli": "bun run --cwd packages/openapi-merge-cli start",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "overrides": {
    "fast-uri": "^4.1.1",
    "js-yaml": "^4.3.0"
  }
}
