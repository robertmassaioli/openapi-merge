{
  "name": "openapi-merge-cli",
  "version": "1.3.2",
  "description": "A cli tool for the openapi-merge library.",
  "keywords": [
    "openapi",
    "merge",
    "cli"
  ],
  "main": "dist/index",
  "bin": {
    "openapi-merge-cli": "dist/cli.js"
  },
  "files": [
    "dist/!(__tests__)",
    "dist/!(__tests__)/**/*"
  ],
  "author": "Robert Massaioli",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "private": false,
  "homepage": "https://github.com/robertmassaioli/openapi-merge",
  "repository": "github:robertmassaioli/openapi-merge",
  "bugs": {
    "url": "https://github.com/robertmassaioli/openapi-merge/issues"
  },
  "devDependencies": {
    "@adobe/jsonschema2md": "8",
    "@types/jest": "^25.2.1",
    "@types/js-yaml": "^3.12.5",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^2.31.0",
    "@typescript-eslint/parser": "^2.31.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "eslint": "^7.0.0",
    "typescript-json-schema": "^0.65.1"
  },
  "dependencies": {
    "@atlassian/atlassian-openapi": "^1.0.6",
    "ajv": "^6.12.2",
    "commander": "^5.1.0",
    "js-yaml": "^3.14.0",
    "openapi-merge": "^1.2.0"
  },
  "scripts": {
    "build": "tsgo --project .",
    "prepare": "bun run --cwd ../openapi-merge build && bun run gen-schema && tsgo --project .",
    "prepublishOnly": "bun run --cwd ../openapi-merge build && bun run gen-schema && tsgo --project .",
    "gen-schema": "bun --bun typescript-json-schema tsconfig.schema.json Configuration --titles --refs --aliasRefs --noExtraProps --required -o src/configuration.schema.json && bun ./src/fix-schema.ts",
    "start": "bun ./src/cli.ts",
    "test": "bun test --coverage",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx --fix --format=visualstudio",
    "gen-docs": "jsonschema2md --input=src"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
